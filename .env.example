# ============================================================================
# OrangeHRM Automation Framework - Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual values
# .env file is excluded from git for security (see .gitignore)
# ============================================================================

# ── Application Configuration ────────────────────────────────────────────
BASE_URL=http://localhost:8080
APP_USERNAME=admin
APP_PASSWORD=admin123
BROWSER=chrome
HEADLESS=false
TIMEOUT=10

# ── Selenium Configuration ───────────────────────────────────────────────
SELENIUM_GRID_URL=http://localhost:4444
SELENIUM_HUB_HOST=localhost
SELENIUM_HUB_PORT=4444

# ── Healenium Configuration ──────────────────────────────────────────────
USE_HEALENIUM=true
HEALENIUM_ENABLED=true
HEALENIUM_PROXY_URL=http://localhost:8085
HEALENIUM_BACKEND_URL=http://localhost:7878
HEALENIUM_AUTO_HEALING=true

# ── Database Configuration ───────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=healenium_user
DATABASE_PASSWORD=healenium_pass
DATABASE_NAME=healenium

# ── Jenkins Configuration ────────────────────────────────────────────────
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_TOKEN=your_jenkins_token_here

# ── Logging Configuration ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/automation.log
LOG_DIR=logs

# ── Test Execution Configuration ─────────────────────────────────────────
TEST_ENV=local
TEST_TIMEOUT=30
RETRY_COUNT=3
SCREENSHOT_ON_FAILURE=true
VIDEO_RECORDING=false

# ── Report Configuration ─────────────────────────────────────────────────
ALLURE_ENABLED=true
ALLURE_RESULTS_DIR=allure-results
GENERATE_HTML_REPORT=true
REPORT_DIR=reports

# ── Proxy Configuration (if behind corporate proxy) ──────────────────────
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1

# ── AWS Configuration (if using S3 for reports) ───────────────────────
# AWS_ACCESS_KEY_ID=your_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your_bucket_name

# ── Slack Notification (optional) ────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SLACK_CHANNEL=#automation-tests

# ── Email Configuration (optional) ───────────────────────────────────────
# EMAIL_ENABLED=false
# EMAIL_SENDER=automation@company.com
# EMAIL_RECIPIENTS=qa-team@company.com
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# ── Debug Configuration ──────────────────────────────────────────────────
DEBUG=false
VERBOSE_LOGGING=false
CAPTURE_NETWORK_LOGS=false
